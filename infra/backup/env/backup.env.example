# Contractor Platform — backup configuration (Sprint 11A.5).
#
# Copy this file to `backup.env` (same directory) and fill in real values for
# the environment you're running in. `backup.env` must NEVER be committed —
# see infra/backup/README.md "Secrets" for what belongs here vs. what must
# live outside this repository entirely.
#
# Every script in infra/backup/scripts/ loads this file itself (see lib.sh,
# load_backup_env) — no variable here needs to be exported by hand first.

# ── Restic repository ───────────────────────────────────────────────────────
# For LOCAL validation (this sprint): a plain filesystem path. For the real
# Hetzner Storage Box (Sprint 11B): sftp:<storagebox-user>@<storagebox-host>:/contractor-platform
# — only this value changes; no script changes when that day comes. Do not
# invent a real Storage Box hostname/username here.
RESTIC_REPOSITORY=/var/backups/contractor-platform/restic-repo

# Pinned image tag — verified against the real restic/restic Docker Hub tags
# at implementation time (0.19.1 was the latest stable release). Deliberately
# not `:latest`: an unpinned tag could silently change the on-disk repository
# format or CLI behavior between runs.
RESTIC_IMAGE=restic/restic:0.19.1

# Host path to a file containing ONLY the repository password (nothing else),
# owned by the user that runs these scripts, chmod 600. This file itself is
# NOT recoverable from the Restic repository it protects (see
# infra/backup/README.md "Perda da RESTIC_PASSWORD") — a copy must also exist
# in a password manager external to this host.
RESTIC_PASSWORD_FILE=/etc/contractor-platform/restic-password

# Restic's local metadata cache — persisted across runs so it doesn't
# re-index the repository every time. Safe to delete (rebuilt automatically);
# never itself part of what gets backed up.
RESTIC_CACHE_DIR=/var/cache/contractor-platform/restic

# ── SFTP (Hetzner Storage Box) ───────────────────────────────────────────────
# Both empty for a local/path repository (as used to validate this sprint).
# RESTIC_SFTP_KEY_FILE: host path to an SSH private key authorized on the
# Storage Box account — never a real path/key committed here.
# RESTIC_SFTP_COMMAND: only needed if the default `sftp user@host` invocation
# Restic derives from RESTIC_REPOSITORY isn't enough (e.g. a non-default key
# path) — fully replaces Restic's sftp command when set, e.g.:
#   RESTIC_SFTP_COMMAND=ssh <storagebox-user>@<storagebox-host> -i /root/.ssh/backup_key -s sftp
RESTIC_SFTP_KEY_FILE=
RESTIC_SFTP_COMMAND=

# ── Retention (DT-011A.5 §15) ────────────────────────────────────────────────
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6

# ── Compose context ──────────────────────────────────────────────────────────
# Used to resolve running containers by service name (docker compose ps -q) —
# scripts never guess a Compose-project-prefixed container/volume name.
# Paths are relative to infra/backup/scripts/ (where the scripts actually run
# from); adjust if backup.env is deployed somewhere else.
BACKUP_COMPOSE_FILE=../../compose/docker-compose.prod.yml
BACKUP_PRODUCTION_ENV=../../env/production.env

# ── Local staging ────────────────────────────────────────────────────────────
# Ephemeral working directory for the PostgreSQL dump and for restore staging
# (see infra/backup/README.md "Por que staging, não streaming"). Must have
# enough free space for one compressed dump / one restored snapshot. Created
# with mode 700 and cleaned up by a trap on every exit path — never
# accumulates files between runs.
BACKUP_STAGING_DIR=/var/tmp/contractor-platform-backup

# ── backend_storage ownership (restore only) ────────────────────────────────
# Inspected from backend/Dockerfile (`addgroup -g 1000 platform && adduser -u
# 1000 ... platform`), not guessed — override only if that Dockerfile ever
# changes its fixed uid/gid.
BACKUP_BACKEND_UID=1000
BACKUP_BACKEND_GID=1000
