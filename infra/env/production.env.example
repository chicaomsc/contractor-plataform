# Contractor Platform — production environment (Sprints 11A.1–11A.6)
#
# Copy this file to `production.env` (same directory) and fill in real values.
# `production.env` must NEVER be committed — it already matches the repo-root
# .gitignore pattern `.env*`, but double-check with `git status` before committing
# anything in this directory.
#
# Every value below either configures `docker compose` itself (image names, the
# version tag, host port publishing) or is passed straight through to a container
# via `env_file:` in docker-compose.prod.yml. Where a variable name requested by a
# generic checklist didn't match anything this codebase actually reads (e.g.
# SPRING_DATASOURCE_URL, CORS_ALLOWED_ORIGINS, UPLOAD_DIRECTORY, JWT_REFRESH_SECRET,
# NEXT_PUBLIC_API_URL, PUBLIC_APP_URL/PUBLIC_API_URL), it is called out explicitly
# below instead of being silently invented — see backend's application.yml and
# frontend's src/lib/env/public-env.ts for the source of truth.
#
# Sprint 11A.3: Caddy is now the only service that publishes a port. No real domain
# is configured below — CADDY_HOST=:80 (the default) is enough for local validation,
# no ACME/Cloudflare/DNS involved. See docs/design/DT-011A.3-caddy-reverse-proxy.md.

# ── docker compose itself ───────────────────────────────────────────────────
# Prefixes container/network/volume names (e.g. contractor_backend_1). Optional —
# compose defaults to the containing directory name if unset.
COMPOSE_PROJECT_NAME=contractor-platform

# Image references. Sprint 11A.4: .github/workflows/publish-images.yml actually
# publishes here now (ghcr.io/chicaomsc — the real GitHub owner of this repo, not
# a placeholder) — see docs/design/DT-011A.4-ghcr-image-pipeline.md. Overriding
# either variable still works for a locally-built image (`docker compose build`),
# same as before.
BACKEND_IMAGE=ghcr.io/chicaomsc/contractor-platform-backend
FRONTEND_IMAGE=ghcr.io/chicaomsc/contractor-platform-frontend

# Immutable tag for both images. "local" is only for `docker compose build` (tags
# the locally-built image with this value). In a real deployment, APP_VERSION must
# be the **full** 40-character commit SHA that publish-images.yml tagged the image
# with (e.g. APP_VERSION=1a2b3c4d5e6f7890abcdef1234567890abcdef12) — that is the
# canonical, immutable reference used for both deploy and rollback (see
# infra/README.md "Rollback"). The short 7-char SHA alias also resolves to the same
# image if typed manually, but do not put a real SHA in THIS example file — it goes
# in `production.env` (never committed), not here.
APP_VERSION=local

# Sprint 11A.3: backend/frontend no longer publish a host port at all — they're
# only reachable from Caddy over the `internal` Docker network (backend:8080,
# frontend:3000). BACKEND_PORT/FRONTEND_HOST_PORT are gone; docker-compose.prod.yml
# doesn't read them anymore. Caddy is now the only service with `ports:`, below.

# ── Caddy (reverse proxy — see infra/caddy/Caddyfile and
#    docs/design/DT-011A.3-caddy-reverse-proxy.md) ──────────────────────────
# Caddy's site address. `:80` (the default) means plain HTTP on all interfaces —
# Caddy never attempts automatic HTTPS/ACME with a bare port. This is what local
# validation should use; it is NOT a placeholder for a real domain. Once a real
# domain is chosen (Sprint 11C+), set CADDY_HOST to that hostname (e.g.
# CADDY_HOST=app.example.com) and Caddy automatically provisions/renews a TLS
# certificate for it — no other change to the Caddyfile is needed. No real domain
# is set here.
CADDY_HOST=:80

# Host-side port(s) Caddy publishes. Only the host side is configurable — Caddy
# always listens on 80/443 internally. Change CADDY_HTTP_PORT if 80 is already
# taken locally by another project (e.g. CADDY_HTTP_PORT=8000).
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443 — currently unused: docker-compose.prod.yml keeps the 443
# publication commented out until CADDY_HOST is a real domain (Sprint 11C+).

# ── PostgreSQL (spring.datasource.* is derived FROM these — do not set
#    DB_URL/DB_USERNAME/DB_PASSWORD separately, see docker-compose.prod.yml) ──
POSTGRES_DB=platform_db
POSTGRES_USER=platform
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_STRONG_SECRET

# ── Backend (Spring Boot — see backend/src/main/resources/application.yml) ──
# Sprint 11A.2: SPRING_PROFILES_ACTIVE is now fixed to "prod" directly in
# docker-compose.prod.yml (backend.environment), not read from this file — it's a
# property of this compose file, not an operator choice, so there is no line to set
# here. Activating "prod" merges application-prod.yml on top of application.yml:
# graceful shutdown, HTTP compression, forward-headers-strategy, liveness/readiness
# probes, production logging levels, and the fail-fast checks below (JWT_SECRET,
# APP_CORS_ALLOWED_ORIGINS, STORAGE_PATH) — see
# docs/design/DT-011A.2-production-configuration.md for the full rationale.
# TZ=UTC is likewise fixed directly in docker-compose.prod.yml, not set here.

# app.jwt.secret — HS256 requires >= 32 bytes. This example value is intentionally
# unusable; generate a real one with e.g. `openssl rand -base64 48`. With profile
# "prod" active, ProductionReadinessValidator refuses to start the backend if this
# is missing, too short, or still equal to this exact placeholder string (or to the
# dev fallback baked into application.yml) — the container never reports healthy,
# instead of failing silently at the first real login.
JWT_SECRET=CHANGE_ME_WITH_A_STRONG_SECRET_MIN_32_CHARS
# There is no separate refresh-token secret to set: refresh tokens are opaque
# random strings persisted in the `refresh_tokens` table (auth.domain.RefreshToken),
# not signed JWTs — JWT_REFRESH_SECRET does not apply to this codebase. Migrating
# the refresh token to an HttpOnly cookie (docs/security/authentication-review.md)
# is also out of scope for this sprint — the current header-based mechanism is kept.

# app.cors.allowed-origins (Spring relaxed binding: APP_CORS_ALLOWED_ORIGINS, not
# CORS_ALLOWED_ORIGINS) — comma-separated list of origins allowed to call the API
# (apex + www shown below as an example; a single origin is just as valid). With
# profile "prod" active, ProductionReadinessValidator requires this variable to be
# present and rejects the whole value if any entry: is blank (e.g. a stray comma),
# is a literal "*" wildcard, is not a valid absolute http/https URL, or is a
# localhost/127.0.0.1 origin. Whitespace around each entry is trimmed automatically
# (both by the validator and by the actual CORS filter), so
# "https://a.pt, https://b.pt" is fine.
#
# Sprint 11A.3: with Caddy fronting both frontend and backend on the same public
# origin, browser requests to /api/* are same-origin and never trigger CORS at
# all — this variable is a defense-in-depth backstop (direct API calls from a
# different origin, non-browser clients, future subdomain splits), not something
# the new topology depends on for the app itself to work. It should still name
# the same public origin(s) the frontend is served from — same value as
# NEXT_PUBLIC_SITE_URL below. ProductionReadinessValidator unconditionally rejects
# a literal "localhost"/"127.0.0.1" host here (see
# backend/.../ProductionReadinessValidator#validateOrigin) — since
# docker-compose.prod.yml fixes SPRING_PROFILES_ACTIVE=prod, this applies to local
# `docker compose up` validation too, not just real deployments. For local
# validation, keep this as any syntactically-valid non-localhost placeholder (the
# CHANGE_ME default below already satisfies that) — the value only needs to match
# textually against the browser's Origin header, it doesn't need to resolve via
# DNS; see infra/README.md's CORS validation commands.
APP_CORS_ALLOWED_ORIGINS=https://CHANGE_ME.example.com,https://www.CHANGE_ME.example.com

# Optional JVM heap override — the defaults already applied in
# docker-compose.prod.yml (-XX:MaxRAMPercentage=70 etc.) are usually sufficient;
# only set this to add flags beyond those.
# JAVA_TOOL_OPTIONS=

# ── Frontend (Next.js — see frontend/src/lib/env/public-env.ts) ────────────
# NEXT_PUBLIC_* values are inlined into the client JS bundle at Docker BUILD time
# (frontend/Dockerfile ARGs), not read at container startup — changing any of the
# three below requires rebuilding the frontend image, not just restarting the
# container. They are also passed through as runtime env vars for the Next.js
# server process itself (next.config.ts reads NEXT_PUBLIC_API_BASE_URL to derive
# its CSP connect-src), which is why they are listed here too.
#
# Sprint 11A.3: same-origin topology via Caddy — NEXT_PUBLIC_API_BASE_URL must be
# the same public origin Caddy serves (the same value as NEXT_PUBLIC_SITE_URL, NOT
# a separate api.* subdomain/origin anymore), because it is Caddy's own /api/*
# rule (handle_path, strips the prefix before forwarding to the backend) that
# makes the API reachable there — the backend's controllers themselves are still
# unprefixed and never exposed on their own origin. The frontend adds the /api
# prefix itself (see frontend/src/lib/api/api-path.ts, withApiPrefix) before
# calling `new URL(path, NEXT_PUBLIC_API_BASE_URL)`, so this variable stays a
# plain origin with no /api suffix and no trailing slash — do not set it to a bare
# path like "/api" (rejected by both the URL constructor and the Zod schema; see
# docs/design/DT-011A.3-caddy-reverse-proxy.md §9 for the empirical check).
#
# For local `docker compose up` validation, a plain "http://localhost" here is
# fine (unlike APP_CORS_ALLOWED_ORIGINS above, nothing rejects a localhost host in
# NEXT_PUBLIC_*) and matches CADDY_HOST=:80/CADDY_HTTP_PORT=80. Real production
# deployment: replace with the real https:// domain Caddy will serve — do not
# deploy with the CHANGE_ME placeholder below.
NEXT_PUBLIC_API_BASE_URL=https://CHANGE_ME.example.com
# Same public origin as NEXT_PUBLIC_API_BASE_URL now that Caddy fronts both — see
# above. Local validation: http://localhost.
NEXT_PUBLIC_SITE_URL=https://CHANGE_ME.example.com

# Optional Node heap override — docker-compose.prod.yml already sets
# NODE_OPTIONS=--max-old-space-size=512 for the frontend service; only set this to
# override that default.
# NODE_OPTIONS=

# ── Platform administration & multi-tenant runtime (Sprint 11A.7 — backend only;
#    see docs/design/DT-011A.7-platform-admin-multitenancy.md) ─────────────────────

# PLATFORM_ADMIN_BOOTSTRAP_EMAIL / PLATFORM_ADMIN_BOOTSTRAP_PASSWORD: read once at
# startup by PlatformAdminBootstrapRunner to create the first SUPER_ADMIN account —
# idempotent (a no-op on every later restart once that account exists). Leave BOTH
# unset to skip bootstrap entirely; setting only one is a configuration error and
# fails startup on purpose (see DT §8). Once the first SUPER_ADMIN exists, these two
# variables can be removed from this file — the plaintext password only needs to be
# present for that one bootstrap run.
# PLATFORM_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_8_CHARS

# PLATFORM_BASE_DOMAIN: the platform's own base domain used to extract a tenant slug
# from a Host value ("{slug}.{PLATFORM_BASE_DOMAIN}") at GET /public/tenant. No real
# domain is configured yet (Sprint 11C) — "localhost" is correct for local validation
# via *.localhost. See DT-011A.7 §16.
PLATFORM_BASE_DOMAIN=localhost

# PLATFORM_DEFAULT_TENANT_SLUG: temporary fallback tenant slug used when the request's
# Host does not resolve to any known subdomain — the case for ALL of production today,
# since Caddy has no real domain yet (CADDY_HOST=:80). Explicitly a transition
# mechanism, not permanent multi-tenant architecture — removable once Sprint 11C
# ships real subdomains. See DT-011A.7 §16/§22/§24.
PLATFORM_DEFAULT_TENANT_SLUG=CHANGE_ME_TENANT_SLUG
